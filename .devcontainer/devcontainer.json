{
  "name": "FRI APP — Java 21 + Spring Boot",
  "image": "mcr.microsoft.com/devcontainers/java:21-bullseye",
  "workspaceFolder": "/workspaces/app-ropa-monolito",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installMaven": true,
      "mavenVersion": "3.9"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-spring-boot-dashboard",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-maven",
        "cweijan.vscode-postgresql-client2",
        "anthropic.claude-code",
        "humao.rest-client",
        "eamodio.gitlens",
        "pkief.material-icon-theme"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [8080, 5432],
  "portsAttributes": {
    "8080": { "label": "Spring Boot API", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "remoteEnv": {
    "SPRING_PROFILES_ACTIVE": "dev",
    "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/friapp_dev",
    "SPRING_DATASOURCE_USERNAME": "friapp",
    "SPRING_DATASOURCE_PASSWORD": "friapp_secret",
    "JWT_SECRET": "changeme_local_only"
  },
  "remoteUser": "vscode"
}
