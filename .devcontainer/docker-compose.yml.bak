version: "3.9"

# ─────────────────────────────────────────────
#  FRI APP — Docker Compose (desarrollo local)
#  Servicios: app (Spring Boot) + db (Postgres) + redis
# ─────────────────────────────────────────────

services:

  # ── Contenedor principal del Codespace ──────
  app:
    image: mcr.microsoft.com/devcontainers/java:21-bullseye
    volumes:
      - ../..:/workspace/app-ropa-monolito:cached          # Monta el repo completo
      - maven-cache:/root/.m2            # Caché de dependencias Maven (persiste entre rebuilds)
    working_dir: /workspace
    command: sleep infinity              # El devcontainer lo mantiene vivo
    environment:
      SPRING_PROFILES_ACTIVE:  dev
      SPRING_DATASOURCE_URL:   jdbc:postgresql://db:5432/friapp_dev
      SPRING_DATASOURCE_USERNAME: friapp
      SPRING_DATASOURCE_PASSWORD: friapp_secret
      SPRING_DATA_REDIS_HOST:  redis
      SPRING_DATA_REDIS_PORT:  "6379"
      JWT_SECRET:              changeme_local_only
    depends_on:
      db:
        condition: service_healthy
    networks:
      - friapp-net

  # ── PostgreSQL ───────────────────────────────
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB:       friapp_dev
      POSTGRES_USER:     friapp
      POSTGRES_PASSWORD: friapp_secret
    volumes:
      - postgres-data:/var/lib/postgresql/data   # Persiste datos entre reinicios
      - ./init-db.sql:/docker-entrypoint-initdb.d/init.sql:ro
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U friapp -d friapp_dev"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - friapp-net

  # ── Redis (opcional para MVP, listo cuando lo necesites) ──
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: redis-server --save 60 1   # Persiste snapshot cada 60s si hay 1+ cambio
    volumes:
      - redis-data:/data
    ports:
      - "6379:6379"
    networks:
      - friapp-net

# ── Volúmenes nombrados ──────────────────────
volumes:
  postgres-data:
  redis-data:
  maven-cache:

# ── Red interna ──────────────────────────────
networks:
  friapp-net:
    driver: bridge
